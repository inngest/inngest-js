{
  "name": "agents-tour",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive tour of inngest/experimental/agents: lesson text, a code editor, a real local Dev Server and a trace",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tour": "node --disable-warning=ExperimentalWarning scripts/tour.ts",
    "tour:devserver": "node --disable-warning=ExperimentalWarning scripts/devserver.ts",
    "tour:check-editor": "node --disable-warning=ExperimentalWarning scripts/check-editor.ts",
    "tour:check": "node --disable-warning=ExperimentalWarning scripts/check.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p site/tsconfig.json && node --disable-warning=ExperimentalWarning scripts/check.ts"
  },
  "dependencies": {
    "inngest": "link:../../packages/inngest/dist",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2",
    "vite": "^7.0.0"
  }
}
