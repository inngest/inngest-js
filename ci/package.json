{
  "name": "inngest-js-ci",
  "version": "1.0.0",
  "private": true,
  "description": "The pull request checks for inngest-js, as @inngest/ci pipelines",
  "type": "module",
  "scripts": {
    "start": "tsx server.ts",
    "ci:connect": "node --env-file=$HOME/.config/inngest-ci-dogfood.env --import tsx connect.ts",
    "test": "tsx --test webhook-transform.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@inngest/ci": "link:../packages/ci/dist",
    "inngest": "link:../packages/inngest/dist"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2"
  }
}
